rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email == 'thomasgawdat3@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isVerifiedServant(participantId) {
      return isValidId(participantId)
        && exists(/databases/$(database)/documents/participants/$(participantId))
        && get(/databases/$(database)/documents/participants/$(participantId)).data.role == 'servant';
    }

    function isValidCompetition(comp) {
      return comp is map
        && comp.keys().hasAll(['enabled', 'titleAr', 'titleEn', 'descriptionAr', 'descriptionEn', 'questions'])
        && comp.keys().hasOnly(['enabled', 'titleAr', 'titleEn', 'descriptionAr', 'descriptionEn', 'rewardAr', 'rewardEn', 'questions'])
        && comp.enabled is bool
        && comp.titleAr is string && comp.titleAr.size() <= 160
        && comp.titleEn is string && comp.titleEn.size() <= 160
        && comp.descriptionAr is string && comp.descriptionAr.size() <= 600
        && comp.descriptionEn is string && comp.descriptionEn.size() <= 600
        && (!('rewardAr' in comp) || (comp.rewardAr is string && comp.rewardAr.size() <= 200))
        && (!('rewardEn' in comp) || (comp.rewardEn is string && comp.rewardEn.size() <= 200))
        && comp.questions is list && comp.questions.size() <= 60;
    }

    function isValidAppConfig(data) {
      return data.keys().hasAll([
          'logoDataUrl', 'accentColor', 'lightCanvasColor', 'darkCanvasColor',
          'radiusPreset', 'cardStyle', 'heroIcon', 'heroIconSize',
          'progressStyle', 'lentStartDate', 'lentEndDate', 'sequentialLock',
          'copy', 'quotes', 'practices', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasOnly([
          'logoDataUrl', 'accentColor', 'lightCanvasColor', 'darkCanvasColor',
          'lightTextColor', 'darkTextColor', 'fontPreset',
          'radiusPreset', 'cardStyle', 'heroIcon', 'heroIconSize',
          'progressStyle', 'sectionOrder', 'layoutSettings', 'elementColors',
          'journeyMigrated', 'pin2027Migrated',
          'lentStartDate', 'lentEndDate', 'sequentialLock', 'christmasTheme',
          'copy', 'quotes', 'practices', 'competition', 'updatedAt', 'updatedBy'
        ])
        && (!('sectionOrder' in data) || (data.sectionOrder is list && data.sectionOrder.size() <= 10))
        && (!('layoutSettings' in data) || data.layoutSettings is map)
        && (!('elementColors' in data) || data.elementColors is map)
        && (!('christmasTheme' in data) || data.christmasTheme is bool)
        && (!('competition' in data) || isValidCompetition(data.competition))
        && (!('fontPreset' in data) || data.fontPreset in ['cairo', 'tajawal', 'almarai', 'amiri', 'rubik'])
        && (!('lightTextColor' in data) || (data.lightTextColor is string && data.lightTextColor.size() <= 20))
        && (!('darkTextColor' in data) || (data.darkTextColor is string && data.darkTextColor.size() <= 20))
        && data.logoDataUrl is string && data.logoDataUrl.size() <= 220000
        && data.accentColor is string && data.accentColor.size() <= 20
        && data.lightCanvasColor is string && data.lightCanvasColor.size() <= 20
        && data.darkCanvasColor is string && data.darkCanvasColor.size() <= 20
        && data.radiusPreset in ['sharp', 'soft', 'rounded']
        && data.cardStyle in ['bordered', 'elevated', 'flat']
        && data.heroIcon in ['heart', 'cross', 'star', 'flame', 'book', 'sun']
        && data.heroIconSize in ['sm', 'md', 'lg']
        && data.progressStyle in ['journey', 'heart']
        && data.lentStartDate is string && data.lentStartDate.size() <= 20
        && data.lentEndDate is string && data.lentEndDate.size() <= 20
        && data.sequentialLock is bool
        && data.copy is map
        && data.quotes is list && data.quotes.size() <= 60
        && data.practices is list && data.practices.size() <= 100
        && data.updatedAt is number
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128;
    }

    function isValidParticipant(data, participantId) {
      return data.keys().hasAll([
          'id', 'fullName', 'pinHash', 'currentDay', 'completedDays',
          'passedChapters', 'checkedPractices', 'readerFontSize',
          'planStartDate', 'completedChapters', 'percent', 'streak',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'fullName', 'pinHash', 'role', 'currentDay', 'completedDays',
          'passedChapters', 'checkedPractices', 'competitionAnswers', 'readerFontSize',
          'planStartDate', 'completedChapters', 'percent', 'streak',
          'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == participantId && data.id.size() <= 128
        && data.fullName is string && data.fullName.size() >= 3 && data.fullName.size() <= 120
        && data.pinHash is string && data.pinHash.size() >= 16 && data.pinHash.size() <= 128
        && (!('role' in data) || data.role in ['member', 'servant'])
        && data.currentDay is number && data.currentDay >= 1 && data.currentDay <= 200
        && data.completedDays is list && data.completedDays.size() <= 200
        && (data.completedDays.size() == 0 || data.completedDays[0] is number)
        && data.passedChapters is map
        && data.checkedPractices is map
        && (!('competitionAnswers' in data) || data.competitionAnswers is map)
        && data.readerFontSize is number && data.readerFontSize >= 12 && data.readerFontSize <= 40
        && data.planStartDate is string && data.planStartDate.size() <= 20
        && data.completedChapters is number && data.completedChapters >= 0 && data.completedChapters <= 89
        && data.percent is number && data.percent >= 0 && data.percent <= 100
        && data.streak is number && data.streak >= 0 && data.streak <= 200
        && data.createdAt is string && data.createdAt.size() <= 40
        && data.updatedAt is number;
    }

    // Shared app configuration: readable by all users, writable by admins (full) or promoted servants (content/competition)
    match /app_config/{configId} {
      allow get: if isValidId(configId) && configId == 'main';
      allow list: if false;
      allow create: if isAdmin() && isValidId(configId) && configId == 'main' && isValidAppConfig(incoming()) && incoming().updatedBy == request.auth.uid;
      allow update: if resource != null
        && isValidId(configId)
        && configId == 'main'
        && isValidAppConfig(incoming())
        && (
          (isAdmin() && incoming().updatedBy == request.auth.uid) ||
          (
            isVerifiedServant(incoming().updatedBy)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'quotes', 'practices', 'competition', 'lentStartDate', 'lentEndDate',
              'accentColor', 'lightCanvasColor', 'darkCanvasColor',
              'lightTextColor', 'darkTextColor', 'fontPreset',
              'radiusPreset', 'cardStyle', 'heroIcon', 'heroIconSize',
              'progressStyle', 'sectionOrder', 'layoutSettings', 'elementColors',
              'christmasTheme',
              'updatedAt', 'updatedBy'
            ])
          )
        );
      allow delete: if false;
    }

    // Registered participants & their reading progress
    match /participants/{participantId} {
      allow get: if isValidId(participantId);
      allow list: if isAdmin();
      allow create: if isValidId(participantId)
        && isValidParticipant(incoming(), participantId)
        && (!('role' in incoming()) || incoming().role == 'member');
      allow update: if resource != null
        && isValidId(participantId)
        && isValidParticipant(incoming(), participantId)
        && (
          isAdmin() ||
          (
            incoming().id == existing().id
            && incoming().createdAt == existing().createdAt
            && incoming().pinHash == existing().pinHash
            && !incoming().diff(existing()).affectedKeys().hasAny(['role'])
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'currentDay', 'completedDays', 'passedChapters', 'checkedPractices',
              'competitionAnswers', 'readerFontSize', 'planStartDate',
              'completedChapters', 'percent', 'streak', 'updatedAt'
            ])
            && (
              !incoming().diff(existing()).affectedKeys().hasAny(['planStartDate'])
              || (existing().completedDays.size() == 0 && incoming().completedDays.size() == 0)
            )
          )
        );
      allow delete: if isAdmin() && isValidId(participantId);
    }

    function isValidSummaryId(summaryId) {
      return summaryId == 'main' || summaryId.matches('^shard_(0[0-9]|1[0-9]|2[0-9]|3[0-1])$');
    }

    // Non-sensitive participant progress summary shards (no pinHash) for promoted Servants and Developers
    match /participants_summary/{summaryId} {
      allow get: if isValidId(summaryId) && isValidSummaryId(summaryId);
      allow list: if false;
      allow create: if isValidId(summaryId)
        && isValidSummaryId(summaryId)
        && incoming().keys().hasAll(['entries', 'updatedAt'])
        && incoming().keys().hasOnly(['entries', 'updatedAt'])
        && incoming().entries is map
        && incoming().entries.size() <= 400
        && incoming().updatedAt is number;
      allow update: if resource != null
        && isValidId(summaryId)
        && isValidSummaryId(summaryId)
        && incoming().keys().hasAll(['entries', 'updatedAt'])
        && incoming().keys().hasOnly(['entries', 'updatedAt'])
        && incoming().entries is map
        && incoming().entries.size() <= 400
        && incoming().updatedAt is number;
      allow delete: if false;
    }

    // Allowlisted admin accounts
    match /admins/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Connection health check doc
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
